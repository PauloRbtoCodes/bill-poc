# Copie para .env e preencha. O .env está no .gitignore.
#   cp .env.example .env

# --- Banco ---------------------------------------------------------------------------
# Padrão: Postgres local do docker-compose. Para Supabase, use a connection string
# de "Connection pooling" (porta 6543) do painel: Project Settings → Database.
DATABASE_URL=postgresql://postgres:billpoc@localhost:55432/billpoc

# --- Anthropic -----------------------------------------------------------------------
# console.anthropic.com → Settings → API keys → Create Key
# Custo real desta POC: alguns centavos de dólar para a caixa inteira.
# Sem esta chave o pipeline roda em modo --somente-cache (usa respostas já gravadas).
ANTHROPIC_API_KEY=

# Opcional: trocar os modelos. A triagem roda no barato, a extração no caro.
MODELO_TRIAGEM=claude-haiku-4-5
MODELO_EXTRACAO=claude-opus-5

# --- Gmail ---------------------------------------------------------------------------
# Caminho do OAuth client baixado do Google Cloud (tipo "App para computador").
# Ver docs/setup.md para o passo a passo.
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json
MAILBOX=financeiro.test@gmail.com

# Filtro opcional no dialeto de busca do Gmail. Vazio = caixa inteira.
# Ex.: GMAIL_QUERY=has:attachment newer_than:90d
GMAIL_QUERY=

# Só se a chave da Anthropic for "identity-linked" (criada dentro de um workspace).
# O ID aparece na URL do console: .../workspaces/<ESTE-VALOR>/ ; ou em Settings.
ANTHROPIC_WORKSPACE_ID=
